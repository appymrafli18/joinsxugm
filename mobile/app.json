{
  "expo": {
    "name": "Vsikolog",
    "slug": "vsikolog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.vsikolog.app"
    },
    "android": {
      "package": "com.vsikolog.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vsikolog memakai lokasimu untuk melacak jarak misi jalan kaki (outdoor)."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF8FD",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Vsikolog memakai mikrofon untuk mengubah ucapanmu menjadi teks di Companion.",
          "speechRecognitionPermission": "Vsikolog memakai pengenalan suara untuk menuliskan ucapanmu menjadi teks."
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "expo-audio",
        {
          "microphonePermission": "Vsikolog memakai mikrofon untuk panggilan dengan psikolog dan input suara di Companion.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
